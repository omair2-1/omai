# Copy to .env and fill in. Never commit .env.

# --- Pick ONE provider (default: gemini - free) -------------------------------
OMAI_PROVIDER=gemini

# gemini : free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# groq   : free key from https://console.groq.com   (set OMAI_PROVIDER=groq)
# GROQ_API_KEY=your-key-here

# ollama : fully local and free, no key (set OMAI_PROVIDER=ollama)
#          install from https://ollama.com then run:  ollama pull llama3.1:8b

# openrouter / openai (custom server) / anthropic (paid): see README

# --- Optional overrides --------------------------------------------------------
# Model names change often. Run `omai --models` to see what your provider offers.
# OMAI_MODEL=
# OMAI_DATA_DIR=~/.omai
# OMAI_WEB_SEARCH=1
# OMAI_MAX_HISTORY_TURNS=20
# OMAI_MAX_TOOL_ROUNDS=12
# OMAI_MAX_TOKENS=4096

# --- Gmail (optional, read-only for now) ---------------------------------------
# See README "Gmail setup" for the 7-step walkthrough to get these two values.
# GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your-client-secret

# --- Telegram (optional: chat with OMAI from your phone) -----------------------
# See README "Phone access via Telegram" for the 2-minute setup.
# OMAI_TELEGRAM_TOKEN=123456789:your-bot-token-from-BotFather
# OMAI_TELEGRAM_USER_ID=your-numeric-id-from-userinfobot

# --- GitHub (optional, free) ----------------------------------------------------
# Personal access token: github.com/settings/tokens -> "Generate new token (classic)"
# -> tick the "repo" scope -> Generate. Read-only use only needs "repo" (or "public_repo"
# if you only care about public repos).
# GITHUB_TOKEN=ghp_your-token-here

# --- YouTube (optional, free) ---------------------------------------------------
# API key: console.cloud.google.com -> APIs & services -> Library -> "YouTube Data API v3"
# -> Enable -> Credentials -> Create credentials -> API key.
# YOUTUBE_API_KEY=your-key-here

# --- Automatic fallback between free providers (optional) ----------------------
# Comma-separated provider names to try, in order, when the primary provider hits a
# rate limit or is overloaded. Only gemini/groq/openrouter/ollama are supported here
# (they share the same message format). Each still needs its own key set above.
# OMAI_FALLBACK_PROVIDERS=groq,ollama
# Optional: override the model used for one fallback provider specifically, e.g.:
# OMAI_MODEL_GROQ=llama-3.3-70b-versatile

# --- WhatsApp (optional, free via Meta's test number) ---------------------------
# See README "WhatsApp" for the setup (free test number + allowlisted recipients).
# WHATSAPP_TOKEN=your-temporary-or-permanent-access-token
# WHATSAPP_PHONE_NUMBER_ID=the-test-number-id-from-meta

# --- Spotify (optional, free, search only - no Premium needed) -----------------
# App: developer.spotify.com/dashboard -> Create app (any name/description;
# redirect URI can be left as http://localhost since this only uses search, no login).
# Copy the Client ID and Client Secret from the app's Settings page.
# SPOTIFY_CLIENT_ID=your-client-id
# SPOTIFY_CLIENT_SECRET=your-client-secret
